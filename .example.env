LLM_API_BASE_KISSKI=https://chat-ai.academiccloud.de/v1
LLM_API_KEY_KISSKI=your-api-key-here
LLM_API_BASE_BLABLADOR=https://api.blablador.fz-juelich.de/v1
LLM_API_KEY_BLABLADOR=your-api-key-here
LLM_TEMPERATURE=0.05 # should be same as target text-2-sql generator
LLM_TOP_P=1.0
LLM_TOP_K=1
LLM_SEED=42
JUDGE_TEMPERATURE=0.0
JUDGE_TOP_P=1.0
JUDGE_TOP_K=1
JUDGE_SEED=42
OPTIMIZER_TEMPERATURE=0.0
OPTIMIZER_TOP_P=1.0
OPTIMIZER_TOP_K=1
OPTIMIZER_SEED=42
# Cost-budget prices for the prompt-optimization runs: EUR per 1M tokens -- set your
# endpoint's real prices. All six are required before any train CLI will start.
PRICE_TASK_INPUT=0.0
PRICE_TASK_OUTPUT=0.0
PRICE_JUDGE_INPUT=0.0
PRICE_JUDGE_OUTPUT=0.0
PRICE_OPTIMIZER_INPUT=0.0
PRICE_OPTIMIZER_OUTPUT=0.0
MLFLOW_EVAL_EXPERIMENT_NAME=water-text2sql-eval
MLFLOW_TRAIN_EXPERIMENT_NAME=train-text2sql
MLFLOW_TRACKING_URI=http://localhost:5000
# Artifacts are uploaded client-side to the local MinIO S3 (see docker-compose.yml).
# Use localhost:9000 from the host; values mirror the minio service credentials.
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=some_access_key
AWS_SECRET_ACCESS_KEY=some_secret_key
# ngrok agent authtoken used by the docker-compose.override.yml ngrok service
# to expose argilla (port 6900) publicly. Get it from https://dashboard.ngrok.com
NGROK_AUTHTOKEN=your-ngrok-authtoken-here

ARGILLA_API_KEY=your-argilla-api-key-here
ARGILLA_PWD=your-argilla-api-key-here

# -------------- Agents setup

OPENMETEO_API_KEY=your-openmeteo-api-key-here
GR2L_MODEL_API_KEY=your-gr2l-api-key-here

WATER_ASSISTANT_ROOT_AGENT_MODEL=openai/qwen3.6-35b-a3b
WATER_ASSISTANT_TEXT_TO_SQL_AGENT_MODEL=openai/qwen3.6-35b-a3b
WATER_ASSISTANT_SQL_BUILDER_MODEL=openai/qwen3.6-35b-a3b
WATER_ASSISTANT_SQL_FIXER_MODEL=openai/qwen3.6-35b-a3b
WATER_ASSISTANT_LLM_API_BASE=https://chat-ai.academiccloud.de/v1
WATER_ASSISTANT_LLM_API_KEY=your-api-key-here