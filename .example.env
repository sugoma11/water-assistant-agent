# Up to 3 KISSKI (base_url, key) pairs -- `kisski`/`kisski2`/`kisski3`. KISSKI
# rate-limits per key, so these exist to spread roles across independent quotas: run
# e.g. the task/student role on `kisski2` while judge + teacher stay on `kisski`, and
# neither competes with the other. Each pair has its own base-URL var, so a key issued
# against a different KISSKI host (rare, but possible) can route there without touching
# the others. With only one key, set all three pairs to the same base_url/key.
LLM_API_BASE_KISSKI_1=https://chat-ai.academiccloud.de/v1
LLM_API_KEY_KISSKI_1=your-api-key-here
LLM_API_BASE_KISSKI_2=https://chat-ai.academiccloud.de/v1
LLM_API_KEY_KISSKI_2=your-second-api-key-here
LLM_API_BASE_KISSKI_3=https://chat-ai.academiccloud.de/v1
LLM_API_KEY_KISSKI_3=your-third-api-key-here
LLM_API_BASE_BLABLADOR=https://api.blablador.fz-juelich.de/v1
LLM_API_KEY_BLABLADOR=your-api-key-here
LLM_API_BASE_OPENROUTER=https://openrouter.ai/api/v1
LLM_API_KEY_OPENROUTER=your-api-key-here
# Pins every openrouter-endpoint call of a run (task, judge, and the GEPA /
# TextGrad / SkillOpt reflection calls) to one OpenRouter provider, so a run is not
# silently load-balanced across providers that differ in quantization, throughput and
# price. Slug as listed by https://openrouter.ai/api/v1/models/<model>/endpoints
# (e.g. parasail, akashml, venice). Fallbacks are disabled with the pin, so an
# unavailable provider fails the call rather than drifting to another one.
# Leave unset for OpenRouter's own routing; ignored by the kisski/blablador endpoints.
LLM_OPENROUTER_PROVIDER=parasail
LLM_TEMPERATURE=0.05 # should be same as target text-2-sql generator
LLM_TOP_P=1.0
LLM_TOP_K=1
LLM_SEED=42
# Transient-error retry budget for every training/eval LLM call (harness +
# textgrad engines). Defaults (25 attempts, 300s wait cap) ride out ~1.7h of
# endpoint outage before aborting a run.
LLM_MAX_ATTEMPTS=25
LLM_RETRY_MAX_WAIT=300
JUDGE_TEMPERATURE=0.0
JUDGE_TOP_P=1.0
JUDGE_TOP_K=1
JUDGE_SEED=42
OPTIMIZER_TEMPERATURE=0.0
OPTIMIZER_TOP_P=1.0
OPTIMIZER_TOP_K=1
OPTIMIZER_SEED=42

SKILLOPT_ANALYST_WORKERS=1
# Price for 3.6 a3b
PRICE_TASK_INPUT=0.14
PRICE_TASK_OUTPUT=1.0
PRICE_JUDGE_INPUT=0.14
PRICE_JUDGE_OUTPUT=1.0
PRICE_OPTIMIZER_INPUT=0.14
PRICE_OPTIMIZER_OUTPUT=1.0
MLFLOW_EVAL_EXPERIMENT_NAME=water-text2sql-eval
MLFLOW_TRAIN_EXPERIMENT_NAME=budgeted-train-text2sql
MLFLOW_TRACKING_URI=http://localhost:5000
# Artifacts are uploaded client-side to the local MinIO S3 (see docker-compose.yml).
# Use localhost:9000 from the host; values mirror the minio service credentials.
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=some_access_key
AWS_SECRET_ACCESS_KEY=some_secret_key
# ngrok agent authtoken used by the docker-compose.argilla.ngrok.yml ngrok service
# to expose argilla (port 6900) publicly. Get it from https://dashboard.ngrok.com
NGROK_AUTHTOKEN=your-ngrok-authtoken-here

ARGILLA_API_KEY=your-argilla-api-key-here
ARGILLA_PWD=your-argilla-api-key-here

# -------------- Agents setup

OPENMETEO_API_KEY=your-openmeteo-api-key-here
GR2L_MODEL_API_KEY=your-gr2l-api-key-here
# Base URL for the GR2L predict endpoint, including the deployment prefix
# (the tool POSTs to {this}/predict_gr2l). Leave unset to disable the GR2L tool.
WATER_ASSISTANT_GR2L_API_BASE_URL=https://your-host/api-weinbau

WATER_ASSISTANT_ROOT_AGENT_MODEL=openai/qwen3.6-35b-a3b
WATER_ASSISTANT_TEXT_TO_SQL_AGENT_MODEL=openai/qwen3.6-35b-a3b
WATER_ASSISTANT_SQL_BUILDER_MODEL=openai/qwen3.6-35b-a3b
WATER_ASSISTANT_SQL_FIXER_MODEL=openai/qwen3.6-35b-a3b
WATER_ASSISTANT_LLM_API_BASE=https://chat-ai.academiccloud.de/v1
WATER_ASSISTANT_LLM_API_KEY=your-api-key-here

# -------------- HTTP service (FastAPI + AG-UI + ADK endpoint)
# The `water-assistant` console script serves the AG-UI ADK endpoint at "/".
WATER_ASSISTANT_HOST=0.0.0.0
WATER_ASSISTANT_PORT=8080
# Required. One SQLAlchemy URL backs ADK sessions + app_users + conversations
# (A1). Must use an ASYNC driver — ADK builds an async engine and db.py derives
# the sync driver for its ORM (postgresql+asyncpg -> psycopg2; sqlite+aiosqlite
# -> sqlite). Prod: Postgres. Dev: a SQLite file.
WATER_ASSISTANT_SESSION_DB_URL=postgresql+asyncpg://user:password@localhost:5432/water
# WATER_ASSISTANT_SESSION_DB_URL=sqlite+aiosqlite:///./water.db
# Required. JWT signing secret for bearer auth (the service refuses to start
# without it). Alias: WATER_ASSISTANT_JWT_SECRET_KEY.
AGENT_JWT_SECRET=change-me
# Admin API key that authorizes /admin/users (absent -> admin API fails closed).
WATER_ASSISTANT_ADMIN_API_KEY=change-me-admin
# Access-token lifetime in days (default 7).
WATER_ASSISTANT_AUTH_TOKEN_TTL_DAYS=7
